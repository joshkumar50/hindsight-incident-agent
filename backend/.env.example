# ============================================================
# AI-RCI Platform - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ---- AWS Configuration ----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ---- AWS Bedrock Configuration ----
# The LLM model to use for root cause analysis
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Bedrock Agent ID (created in AWS Console)
BEDROCK_AGENT_ID=your_bedrock_agent_id
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# ---- Prometheus Configuration ----
# URL where Prometheus is accessible (e.g., via LoadBalancer or port-forward)
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
# Or use the external URL if accessing from outside the cluster
PROMETHEUS_EXTERNAL_URL=http://your-prometheus-loadbalancer:9090

# ---- Elasticsearch (EFK Stack) Configuration ----
ELASTICSEARCH_URL=http://elasticsearch.logging.svc.cluster.local:9200
ELASTICSEARCH_EXTERNAL_URL=http://your-elasticsearch-loadbalancer:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
# Index pattern for application logs (supports wildcards)
ELASTICSEARCH_LOG_INDEX=fluentd-*
# Index pattern for EKS system logs
ELASTICSEARCH_SYSTEM_INDEX=kubernetes-*

# ---- Jaeger Configuration ----
JAEGER_URL=http://jaeger.tracing.svc.cluster.local:16686
JAEGER_EXTERNAL_URL=http://your-jaeger-loadbalancer:16686
# Jaeger collector endpoint (for sending spans)
JAEGER_COLLECTOR_URL=http://jaeger-collector.tracing.svc.cluster.local:14268

# ---- Lambda Configuration ----
LAMBDA_FUNCTION_NAME=ai-rca-analyzer
LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/ai-rca-lambda-role
# How many minutes of data to look back for analysis
LAMBDA_LOOKBACK_MINUTES=30
# Maximum number of log entries to fetch per query
LAMBDA_MAX_LOG_ENTRIES=500

# ---- CloudWatch Configuration ----
# CloudWatch Log Group for Lambda function logs
CLOUDWATCH_LOG_GROUP=/aws/lambda/ai-rca-analyzer
# SNS Topic ARN for alerting (optional)
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:rca-alerts

# ---- EKS Cluster Configuration ----
EKS_CLUSTER_NAME=your-eks-cluster
EKS_REGION=us-east-1

# ---- Application Configuration ----
# The namespace(s) to monitor in EKS (comma-separated)
MONITORED_NAMESPACES=default,production,staging
# Application name filter for log queries
APP_LABEL_SELECTOR=app

# ---- Streamlit Configuration ----
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
